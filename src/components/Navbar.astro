---
const navLinks = [
  { href: "/samarbeidspartnere", label: "Samarbeidspartnere" },
  { href: "/sponsorpakker", label: "Reklame & lysstolper" },
  { href: "/stolperegisteret", label: "Stolperegisteret" },
  { href: "/kontakt", label: "Kontakt" },
  { href: "https://ilros.no/ski", label: "IL ROS Ski", external: true },
];
---

<nav class="bg-ros-blue shadow-md fixed w-full z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-3 hover:opacity-90 transition">
        <img
          src="/images/logoILROS.png"
          alt="IL ROS logo"
          class="h-10 w-auto bg-white rounded-md p-1"
        />
        <span class="text-lg font-extrabold text-white tracking-tight leading-tight">
          Spikkestad<br class="hidden sm:block" /> Skiarena
        </span>
      </a>

      <!-- Desktop links -->
      <ul class="hidden md:flex space-x-7 text-blue-100 font-semibold items-center text-sm">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noopener noreferrer" : undefined}
              class="hover:text-ros-orange transition">
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- Hamburger button -->
      <button
        onclick="toggleMenu()"
        class="md:hidden text-white focus:outline-none"
        aria-label="Åpne meny">
        <svg
          class="w-8 h-8"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

    <!-- Mobile menu -->
    <ul id="mobile-menu" class="hidden md:hidden flex-col space-y-1 text-blue-100 font-semibold p-4 border-t border-white/10">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
            class="block py-2 hover:text-ros-orange transition">
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<div class="h-2 md:h-5"></div>

<script>
  window.toggleMenu = function () {
    const menu = document.getElementById("mobile-menu");
    menu?.classList.toggle("hidden");
  };
</script>
