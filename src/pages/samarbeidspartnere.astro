---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/tailwind.css";

// TODO: legg til logo-filer i public/images og fyll inn listen når partnere er på plass
const partnere: { navn: string; logo?: string }[] = [];
---

<BaseLayout title="Samarbeidspartnere – Spikkestad Skiarena">
  <Navbar />

  <main class="max-w-4xl mx-auto pt-24 pb-16 px-6">
    <span class="block text-center">
      <span class="inline-block bg-ros-orange text-white text-xs font-bold tracking-wide uppercase px-3 py-1 rounded-full mb-4">
        Spikkestad Skiarena
      </span>
    </span>
    <h1 class="text-xl md:text-4xl font-extrabold text-center mb-6 text-ros-ink">
      Samarbeidspartnere
    </h1>
    <p class="text-lg text-ros-slate text-center max-w-2xl mx-auto mb-10">
      Spikkestad Skiarena drives med god hjelp fra lokale bedrifter som
      støtter skigruppa i <strong class="text-ros-ink">IL ROS</strong>. Her presenterer vi våre
      samarbeidspartnere.
    </p>

    {partnere.length > 0 ? (
      <div class="bg-white rounded-xl shadow-md p-6 md:p-10 flex flex-wrap justify-center items-center gap-8 border-t-4 border-ros-blue">
        {partnere.map((p) => (
          <img src={p.logo} alt={`${p.navn} logo`} class="h-14 object-contain" />
        ))}
      </div>
    ) : (
      <div class="bg-white rounded-xl shadow-md p-6 md:p-10 text-center text-ros-slate border-t-4 border-ros-blue">
        <p>Vi jobber med å knytte til oss samarbeidspartnere – listen fylles ut fortløpende.</p>
      </div>
    )}

    <div class="mt-10 text-center">
      <h2 class="text-2xl font-semibold text-ros-ink mb-3">Ønsker din bedrift å bli med?</h2>
      <p class="text-ros-slate mb-6">
        Vi har flere sponsormuligheter, blant annet reklameplass i Skihytta
        og lysstolper i marka.
      </p>
      <a
        href="/sponsorpakker"
        class="inline-block bg-ros-orange text-white font-semibold py-3 px-6 rounded-lg shadow-md hover:bg-ros-orange-dark transition">
        Se sponsormuligheter
      </a>
    </div>
  </main>

  <Footer />
</BaseLayout>
