---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/tailwind.css";
---

<BaseLayout title="Spikkestad Skiarena">
  <Navbar />

  <main class="pt-6 px-6">
    <!-- Hero-seksjon -->
    <section class="text-center pt-12 pb-4">
      <span class="inline-block bg-ros-orange text-white text-xs font-bold tracking-wide uppercase px-3 py-1 rounded-full mb-4">
        IL ROS Ski
      </span>
      <h1 class="text-2xl md:text-5xl font-extrabold mb-4 p-4 text-ros-ink">
        Spikkestad Skiarena
      </h1>
      <p class="text-base md:text-xl max-w-2xl mx-auto text-ros-slate">
        Vi videreutvikler skistadion på Spikkestad til en arena for hele
        nærmiljøet. Bli med som samarbeidspartner og vær med på å bygge
        fremtidens skiarena for <strong class="text-ros-ink">IL ROS Ski</strong>.
      </p>

      <div class="mt-6 flex flex-col md:flex-row justify-center items-center gap-4">
        <a
          href="/sponsorpakker"
          class="bg-ros-orange text-white font-semibold py-3 px-6 rounded-lg shadow-md hover:bg-ros-orange-dark transition">
          Bli samarbeidspartner
        </a>
        <a
          href="/kontakt"
          class="bg-ros-blue text-white font-semibold py-3 px-6 rounded-lg shadow-md hover:bg-ros-blue-dark transition">
          Ta kontakt
        </a>
      </div>
    </section>

    <!-- Om stadion -->
    <section class="max-w-4xl mx-auto mt-10 mb-6 px-6">
      <div class="bg-white rounded-xl shadow-md overflow-hidden p-6 md:p-10 border-t-4 border-ros-blue">
        <h2 class="text-2xl font-bold text-ros-ink mb-4">Om utviklingen av stadion</h2>
        <p class="text-ros-slate leading-relaxed mb-4">
          Skistadion på Spikkestad er hjemmebane for skigruppa i
          <strong class="text-ros-ink">IL ROS</strong>, og et samlingspunkt for barn, ungdom og
          voksne i nærmiljøet. Vi er nå i gang med å videreutvikle anlegget –
          fra Skihytta til løypenettet innover i Kjekstadmarka – for å skape
          bedre forhold for trening, konkurranse og skiglede for alle.
        </p>
        <p class="text-ros-slate leading-relaxed">
          Denne siden skal fungere som informasjonskanal om utviklingen, og
          som en møteplass mellom klubben og lokale bedrifter som ønsker å
          støtte satsingen.
        </p>
      </div>
    </section>

    <!-- Samarbeidspartnere teaser -->
    <section class="max-w-4xl mx-auto mb-6 px-6">
      <div class="bg-white rounded-xl shadow-md overflow-hidden p-6 md:p-10 text-center">
        <h2 class="text-2xl font-bold text-ros-ink mb-3">Samarbeidspartnere</h2>
        <p class="text-ros-slate mb-6">
          Se hvem som allerede støtter Spikkestad Skiarena – og hvordan din
          bedrift kan bli en del av laget.
        </p>
        <a
          href="/samarbeidspartnere"
          class="inline-block text-ros-blue font-semibold hover:text-ros-orange transition">
          Se samarbeidspartnere →
        </a>
      </div>
    </section>

    <!-- Sponsormuligheter teaser -->
    <section class="max-w-4xl mx-auto mb-16 px-6">
      <div class="bg-ros-blue-tint rounded-xl shadow-md overflow-hidden p-6 md:p-10 text-center border border-ros-blue/10">
        <h2 class="text-2xl font-bold text-ros-ink mb-3">Reklameplass i Skihytta & spons en lysstolpe</h2>
        <p class="text-ros-slate mb-6">
          Vi tilbyr reklameplass på veggen i Skihytta, og du kan sponse din
          egen lysstolpe i ROS-løypa – for privatpersoner, familier, lag og
          bedrifter. Les mer om mulighetene.
        </p>
        <a
          href="/sponsorpakker"
          class="inline-block bg-ros-orange text-white font-semibold py-3 px-6 rounded-lg shadow-md hover:bg-ros-orange-dark transition">
          Se sponsormuligheter
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
