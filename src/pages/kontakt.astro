---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/tailwind.css";
---

<BaseLayout title="Kontakt – Spikkestad Skiarena">
  <Navbar />

  <main class="max-w-4xl mx-auto pt-24 pb-16 px-6">
    <span class="block text-center">
      <span class="inline-block bg-ros-orange text-white text-xs font-bold tracking-wide uppercase px-3 py-1 rounded-full mb-4">
        Spikkestad Skiarena
      </span>
    </span>
    <h1 class="text-xl md:text-4xl font-extrabold text-center mb-8 text-ros-ink">
      Kontakt
    </h1>

    <section class="bg-white rounded-xl shadow-md p-6 md:p-10 border-t-4 border-ros-blue space-y-6 text-lg leading-relaxed">
      <p class="text-ros-slate">
        For spørsmål om <strong class="text-ros-ink">Spikkestad Skiarena</strong>, samarbeid,
        reklameplasser eller lysstolper i marka, ta kontakt med
        <strong class="text-ros-ink">IL ROS Skigruppa</strong>.
      </p>

      <h2 class="text-2xl font-semibold mt-10 mb-2 text-ros-ink">
        Hovedkontakt – IL ROS Skigruppa
      </h2>
      <p class="text-ros-slate">
        <strong class="text-ros-ink">E-post:</strong>
        <a href="mailto:ski@ilros.no" class="text-ros-blue hover:text-ros-orange transition">ski@ilros.no</a>
      </p>

      <h2 class="text-2xl font-semibold mt-10 mb-2 text-ros-ink">
        Om IL ROS – Skigruppa
      </h2>
      <p class="text-ros-slate">
        <strong class="text-ros-ink">IL ROS</strong> (Idrettslaget Røyken og Spikkestad) er en
        aktiv fleridrettsforening i Røyken. Skigruppa jobber for skiglede
        for barn, ungdom og voksne gjennom trening, aktivitet og lokale
        renn, med Spikkestad Skiarena som hjemmebane.
      </p>

      <p class="text-ros-slate">
        Les mer om klubben på
        <a
          href="https://www.ilros.no/ski/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-ros-blue hover:text-ros-orange transition"
        >
          www.ilros.no
        </a>.
      </p>
    </section>
  </main>

  <Footer />
</BaseLayout>
