---
const navLinks = [
  { href: "/samarbeidspartnere", label: "Samarbeidspartnere" },
  { href: "/sponsorpakker", label: "Reklame & lysstolper" },
  { href: "/kontakt", label: "Kontakt" },
];
---

<nav class="bg-white/90 backdrop-blur-md shadow-md fixed w-full z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-3 hover:opacity-90 transition">
        <h1 class="text-xl font-bold text-gray-800">Spikkestad Skiarena</h1>
      </a>

      <!-- Desktop links -->
      <ul class="hidden md:flex space-x-6 text-gray-700 font-medium items-center">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class="hover:text-blue-600">{link.label}</a>
          </li>
        ))}
      </ul>

      <!-- Hamburger button -->
      <button
        onclick="toggleMenu()"
        class="md:hidden text-gray-700 focus:outline-none"
        aria-label="Åpne meny">
        <svg
          class="w-8 h-8"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

    <!-- Mobile menu -->
    <ul id="mobile-menu" class="hidden md:hidden flex-col space-y-2 text-gray-700 font-medium p-4">
      {navLinks.map((link) => (
        <li>
          <a href={link.href} class="block py-1 hover:text-blue-600">{link.label}</a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<div class="h-2 md:h-5"></div>

<script>
  window.toggleMenu = function () {
    const menu = document.getElementById("mobile-menu");
    menu.classList.toggle("hidden");
  };
</script>
